# Sao chep cac dong duoi day thanh file .env rieng (khong commit .env len git)
# Token cua Page (lay tu Meta App, xem README.md)
PAGE_ACCESS_TOKEN=

# Chuoi bat ky do ban tu dat, dung de xac minh webhook voi Meta
VERIFY_TOKEN=hikarigo-secret-2026

# App Secret cua Meta App (khuyen cao, de xac thuc tin nhan den tu Meta)
APP_SECRET=

# Cong chay bot (Render/Railway tu set PORT)
PORT=3000

# --- AI tra loi tu do (tuy chon, de trong thi bot chi dung FAQ) ---
# Vi du tuong thich OpenAI API:
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Cac cum tu kich hoat chuyen cho nhan vien, cach nhau bang dau phay
HANDOVER_KEYWORDS=nhân viên,người thật,gọi điện,tư vấn viên
